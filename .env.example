# Copia este archivo a .env y ajusta los valores.
POSTGRES_USER=moss
POSTGRES_PASSWORD=moss
POSTGRES_DB=moss
POSTGRES_PORT=5432

DATABASE_URL=postgres://moss:moss@localhost:5432/moss
API_PORT=3000
# Puerto de `pnpm dev` de la web (4200 por defecto). Cambia API_PORT y WEB_PORT en otro worktree.
WEB_PORT=4200
# Playwright: puertos de la API y la web de pruebas (3100 y 4300 por defecto).
# E2E_API_PORT=3100
# E2E_WEB_PORT=4300
# Genera un secreto: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotarlo y reiniciar la API invalida todas las sesiones. Nunca usar un valor compartido de ejemplo.
SESSION_SECRET=
NODE_ENV=development
# 0 para acceso directo/local. En producción configura solo los proxies que realmente controlas.
TRUST_PROXY_HOPS=0
TZ_BUSINESS=America/Mexico_City
